// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  email     String   @unique
  googleId  String?  @unique
  image     String?
  name      String?
  password  String?
  updatedAt DateTime @updatedAt
}

enum ProjectType {
  PERSONAL
  TEAM
}

enum ProjectStatus {
  LIVE
  IN_DEVELOPMENT
  COMPLETED
  ARCHIVED
}

/// A portfolio case study.
///
/// `featured` splits the home page: featured projects render as full
/// `ProjectArticle` blocks under "Selected work", the rest as compact
/// `MoreWorkRow`s. Within each group the list is ordered by `order`.
model Project {
  id   String @id @default(cuid())
  slug String @unique

  type   ProjectType   @default(PERSONAL)
  status ProjectStatus @default(COMPLETED)

  shortLabel String

  titleUk String
  titleEn String

  subtitleUk String
  subtitleEn String

  contextUk String
  contextEn String

  leadUk String
  leadEn String

  roleUk String
  roleEn String

  stack String[] @default([])

  statusUk String?
  statusEn String?

  yearLabel String?

  externalUrl String?
  linkLabelUk String?
  linkLabelEn String?
  linkNoteUk  String?
  linkNoteEn  String?

  featuresUk String[] @default([])
  featuresEn String[] @default([])

  githubUrl    String?
  storybookUrl String?

  order     Int     @default(0)
  featured  Boolean @default(false)
  published Boolean @default(true)

  photos   Photo[]
  sections ProjectSection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([featured, order])
  @@index([published])
}

/// One numbered block of a case study ("01 Context", "02 My role", …).
/// Optional second paragraph for sections that need additional detail.
model ProjectSection {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  order Int @default(0)

  titleUk String
  titleEn String

  bodyUk String
  bodyEn String

  body2Uk String?
  body2En String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model MediaAsset {
  mimeType       String?
  id             String  @id @default(cuid())
  imageKitFileId String  @unique
  src            String
  width          Int
  height         Int

  defaultForPhotos   Photo[]      @relation("DefaultPhotoAsset")
  ukrainianForPhotos Photo[]      @relation("UkrainianPhotoAsset")
  experimentCovers   Experiment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A small Playground experiment (AI/animation/UI prototype), shown as a
/// compact card on the home page and a full article on `/playground`.
/// Single cover image — unlike `Project`, experiments don't need a gallery.
model Experiment {
  id   String @id @default(cuid())
  slug String @unique

  titleUk String
  titleEn String

  descriptionUk String
  descriptionEn String

  stack String?

  demoUrl   String?
  githubUrl String?

  coverAssetId String?
  coverAsset   MediaAsset? @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)

  order     Int     @default(0)
  published Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Photo {
  id String @id @default(cuid())

  assetId String
  asset   MediaAsset @relation("DefaultPhotoAsset", fields: [assetId], references: [id], onDelete: Restrict)

  assetUkId String?
  assetUk   MediaAsset? @relation("UkrainianPhotoAsset", fields: [assetUkId], references: [id], onDelete: Restrict)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  orderInProject Int     @default(0)
  isProjectCover Boolean @default(false)

  captionUk String?
  captionEn String?

  linkUrl       String?
  descriptionUk String?
  descriptionEn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId])
  @@index([assetUkId])
  @@index([projectId, orderInProject])
}
